  <Group id="xccdf_org.ssgproject.content_group_accounts">
    <title xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US">Protect Accounts by Restricting Password-Based Login</title>
    <description xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US">Overly-simple or commonly-used passwords provide attackers with access to systems.</description>
    <Rule id="xccdf_org.ssgproject.content_rule_accounts_password_minlen_login_defs" selected="true" weight="10.000000" role="full" severity="medium">
      <version>RHEL-09-611090</version>
      <title xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US">RHEL 9 must enforce a minimum 15-character password length.</title>
      <description xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US">The minimum password length must be at least 15 characters.</description>
      <ident system="https://public.cyber.mil/stigs/cci/">CCI-000205</ident>
      <fixtext xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US" fixref="F-001_fix">Configure RHEL 9 to enforce a minimum 15-character password length by setting PASS_MIN_LEN to 15 in /etc/login.defs.</fixtext>
      <fix xmlns:xhtml="http://www.w3.org/1999/xhtml" id="F-001_fix"/>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref name="oval:ssg-accounts_password_minlen_login_defs:def:1" href="ssg-rhel9-oval.xml"/>
      </check>
    </Rule>
    <Rule id="xccdf_org.ssgproject.content_rule_accounts_max_concurrent_login_sessions" selected="true" weight="10.000000" role="full" severity="low">
      <version>RHEL-09-412020</version>
      <title xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US">RHEL 9 must limit the number of concurrent sessions to 10.</title>
      <description xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US">Operating system management includes the ability to control the number of users and user sessions that utilize an operating system.</description>
      <ident system="https://public.cyber.mil/stigs/cci/">CCI-000054</ident>
      <fixtext xmlns:xhtml="http://www.w3.org/1999/xhtml" xml:lang="en-US" fixref="F-002_fix">Configure RHEL 9 to limit the number of concurrent sessions by adding: * hard maxlogins 10 to /etc/security/limits.conf.</fixtext>
      <fix xmlns:xhtml="http://www.w3.org/1999/xhtml" id="F-002_fix"/>
      <check system="http://oval.mitre.org/XMLSchema/oval-definitions-5">
        <check-content-ref name="oval:ssg-accounts_max_concurrent_login_sessions:def:1" href="ssg-rhel9-oval.xml"/>
      </check>
    </Rule>
  </Group>
